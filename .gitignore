# Dependencies
node_modules

# Build output
dist
dist-ssr
*.local

# npm cache (used during install attempts; includes versioned variants like .npm-cache-p6)
.npm-cache*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
vite-dev.log
npm-install*.log
# Playwright run logs (pw-all.log / pw10d.log ... produced by validation runs)
pw-*.log
pw[0-9]*.log

# Vite temporary build artifacts
vite.config.ts.timestamp-*.mjs

# Playwright artifacts
test-results/
playwright-report/

# Validation build / Playwright output dirs (generated during sandbox validation runs)
build-out-*/
pw-*/
pw-out/
.pw-*/
.pw-results/

# Editor / OS
.DS_Store
*.swp
.idea
.vscode

# WorkBuddy internal state (assistant memory, not project source)
.workbuddy

# Project docs: dev docs + the ~98MB rules PDF stay untracked.
# Phase 11A audit deliverables under docs/reports/ and docs/data/ ARE tracked (spec §34).
docs/*
!docs/reports/
!docs/data/
docs/references/

# Phase 11A audit run logs (throwaway, not deliverables)
audit-*.log
*.audit.log

