{
  "name": "darkest-dungeon-web-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/integration",
    "test:e2e:critical": "node scripts/e2e/run-critical-e2e.mjs",
    "test:e2e:lifecycle": "node scripts/e2e/run-critical-e2e.mjs && node scripts/e2e/run-critical-e2e.mjs",
    "test:e2e:community-reference": "node scripts/e2e/run-community-reference-e2e.mjs",
    "verify:phase11a2-3": "vite-node scripts/audit/verify-phase11a2-3.ts",
    "audit:content": "vite-node scripts/audit/content.ts",
    "audit:rules": "vite-node scripts/audit/rules.ts",
    "audit:release-gate": "vite-node scripts/audit/release-gate.ts",
    "audit:phase11a3-report": "vite-node scripts/audit/generate-phase11a3-report.ts",
    "audit:production-command": "vite-node scripts/audit/production-command.ts",
    "test:golden": "vitest run src/audit/core-campaign",
    "audit:all": "vite-node scripts/audit/all.ts",
    "audit:final-report": "vite-node scripts/audit/final-report.ts",
    "audit:performance-baseline": "vite-node scripts/audit/performance-baseline.ts",
    "verify:phase11a2-final": "vite-node scripts/audit/verify-phase11a2-final.ts",
    "audit:official-source": "vite-node scripts/audit/official-source.ts",
    "verify:phase11a3-source-gate": "vite-node scripts/audit/verify-phase11a3-source-gate.ts",
    "generate:community-reference-normalized": "node scripts/audit/generate-community-reference-normalized.mjs",
    "verify:community-reference-binding": "vite-node scripts/audit/verify-community-reference-binding.ts",
    "verify:community-reference-runtime": "vite-node scripts/audit/verify-community-reference-runtime.ts",
    "verify:phase11a3-clean-evidence": "vite-node scripts/audit/verify-phase11a3-clean-evidence.ts",
    "verify:phase11a3-infrastructure-acceptance": "vite-node scripts/audit/verify-phase11a3-infrastructure-acceptance.ts",
    "verify:community-visual-assets": "node --experimental-strip-types scripts/audit/verify-community-visual-assets.mts",
    "verify:community-visual-assets:adversarial": "node --experimental-strip-types scripts/audit/verify-community-visual-assets.mts --adversarial",
    "import:community-reference-assets": "node scripts/assets/import-community-reference-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.408.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
